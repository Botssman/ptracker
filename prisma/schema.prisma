generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())
  groups    PurchaseGroup[]
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

model Product {
  id             Int       @id @default(autoincrement())
  network        String
  brand          String
  nomenclature   String
  link           String?
  monthlyPlanQty Int       @default(0)
  isActive       Boolean   @default(true)
  thumbnailPath  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  groupItems     PurchaseGroupItem[]
}

model PurchaseGroup {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id])
  network          String
  name             String
  phone            String?
  period           String
  status           GroupStatus @default(ACTIVE)
  discountCardPath String?
  totalSum         Decimal?  @db.Decimal(12,2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  items            PurchaseGroupItem[]
  receipts         Receipt[]
}

enum GroupStatus {
  ACTIVE
  PENDING_REVIEW
  COMPLETED
}

model PurchaseGroupItem {
  id           Int       @id @default(autoincrement())
  groupId      Int
  group        PurchaseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product   @relation(fields: [productId], references: [id])
  assignedQty  Int       @default(1)
  purchasedQty Int       @default(0)
  userMarkedQty Int      @default(0)
  modConfirmed Boolean   @default(false)
  price        Decimal?  @db.Decimal(12,2)
}

model Receipt {
  id           Int       @id @default(autoincrement())
  groupId      Int
  group        PurchaseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  filePath     String
  originalName String?
  uploadedAt   DateTime  @default(now())
}

model InviteCode {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  role      Role       @default(USER)
  status    CodeStatus @default(UNUSED)
  usedById  Int?
  createdAt DateTime   @default(now())
  usedAt    DateTime?
}

enum CodeStatus {
  UNUSED
  USED
  EXPIRED
}

model Network {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}
